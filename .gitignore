# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the documented template must be committed, otherwise the
# required variables are only discoverable on whoever's machine.
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# ── runtime data ──────────────────────────────────────────────
# Live SQLite databases, not source. db/custom.db was tracked by mistake
# and carried 443 password hashes and 697 live session tokens — which are
# bearer credentials — into ten commits of history. It has been purged from
# history; this keeps it out for good. The file stays on disk: the app needs
# it, git just must not own it.
db/*.db
db/*.db-journal
db/*.db-shm
db/*.db-wal
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3
