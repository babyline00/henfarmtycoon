# ── SQLite (single node, zero setup — default) ─────────────────
DATABASE_URL=file:../db/custom.db

# ── Docker (already handled by docker-compose.yml) ─────────────
# DATABASE_URL=file:/app/custom.db

# ── PostgreSQL (horizontal scale) ──────────────────────────────
# 1) change provider = "postgresql" in prisma/schema.prisma
# 2) DATABASE_URL=postgresql://USER:PASS@HOST:5432/henfarm?schema=public
# 3) npx prisma db push && npx tsx scripts/seed.ts

# ── Auth abuse limits (optional, defaults shown) ────────────────
# Login is the brute-force vector, so its ceiling is tight. Register is
# looser because an entire office, campus or mobile carrier can sit
# behind one NAT address. Raise these only for automated test runs.
# AUTH_LOGIN_RATE=10
# AUTH_LOGIN_WINDOW_MS=300000
# AUTH_REGISTER_RATE=20
# AUTH_REGISTER_WINDOW_MS=600000

# ── Reverse proxy ──────────────────────────────────────────────
# The login/register rate limiter keys on x-forwarded-for / x-real-ip.
# Terminate TLS at a proxy (nginx/Caddy/Cloudflare) so that header is
# set to the true client address, and strip any inbound copy of it at
# the edge — otherwise a client can spoof its own IP to bypass limits.
